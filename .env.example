# 必要な env vars のテンプレート。
# ローカル開発: .env.local を作成し、実値の代わりに op:// 参照を書く。
#   起動: npm run deploy:sakura （op run が op:// を実値に展開して注入する）
# 本番 GitHub Pages: .github/workflows/pages-deploy.yml がビルド時に直接設定。

# === さくらレンタルサーバー（本番／NIJL系） ===
SAKURA_HOST=op://Personal/<item-name>/host
SAKURA_USER=op://Personal/<item-name>/username
SAKURA_PASSWORD=op://Personal/<item-name>/password
SAKURA_DRUPAL_PATH=op://Personal/<item-name>/drupal_path
SAKURA_WWW_PATH=op://Personal/<item-name>/www_path
