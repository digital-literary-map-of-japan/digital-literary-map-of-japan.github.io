        "field_author": "西行法師",
        "field_author_romaji": "Saigyō hōshi",
        "field_document_numbering": "新古今(978)",
        "field_id": "6150528eb518fb8bf3eac40f",
        "field_kotobagaki": "天王寺へまひり侍けるに、にはかに雨ふりけれは、江口にやとをかりけるに、かし侍らさりけれは、よみ侍りける",
        "field_kotobagaki_long": "天王寺へまひり侍けるに、にはかに雨ふりけれは、江口にやとをかりけるに、かし侍らさりけれは、よみ侍りける",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007100/viewer/147",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "ゑぐち",
        "field_text": "世中を / いとふまてこそ / かたからめ / かりのやとりを / おしむ君かな",
        "field_text_romaji": "yo no naka o / itou made koso / katakarame / kari no yadori o / oshimu kimi kana",
        "field_text_romaji_long": "yo no naka o / itou made koso / katakarame / kari no yadori o / oshimu kimi kana",
        "field_translations": "[{'text': 'so difficult it/  is to learn to reject/  this world of ours/  but you begrudge me even/  a temporary lodging', 'source': 'Rodd, Laurel Rasplica (2015): p.402'}]",
        "field_volume": "巻第十・羈旅歌"
      },
