        "field_id": "615052b3211abd623860dd65",
        "field_kotobagaki": "寛治八年前太政大臣高陽院哥合に郭公を",
        "field_kotobagaki_long": "寛治八年前太政大臣高陽院哥合に郭公を",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007100/viewer/40",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "まちかねやま",
        "field_text": "夜をかさね / 待かね山の / 時鳥 / 雲ゐのよそに / 一こゑそきく",
        "field_text_romaji": "yo o kasane / Machikaneyama no / hototogisu / kumoi no yoso ni / hitokoe zo kiku",
        "field_text_romaji_long": "yo o kasane / Machikaneyama no / hototogisu / kumoi no yoso ni / hitokoe zo kiku",
        "field_translations": "[{'text': 'night upon night \\tso/ difficult to wait \\thigh on/ Mount Machikane/ I hear one song resound from/ beyond the clouds \\tnightingale', 'source': 'Rodd, Laurel Rasplica (2015): p.92'}]",
        "field_volume": "巻第三・夏歌"
