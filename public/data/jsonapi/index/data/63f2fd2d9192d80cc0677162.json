        "field_text": "東ちの / さののふなはし / かけてのみ / おもひわたるを / しる人のなさ",
        "field_text_romaji": "azumaji no / Sano no funahashi / kakete nomi / omoiwataru o /shiru hito no nasa",
        "field_text_romaji_long": "azumaji no / Sano no funahashi / kakete nomi / omoiwataru o /shiru hito no nasa",
        "field_translations": "[{'text': 'Sent to a person.//  In the east/ the fishing bridge of Sano/  as it spans, so my heart alone/ what it thinks/  there is no one who knows.', 'source': 'Kern, J. Christopher'}]",
        "field_volume": "巻第十・恋二"
      },
