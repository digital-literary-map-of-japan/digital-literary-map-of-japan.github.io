        "field_place_form": "さののなかがわ",
        "field_text": "すみなれし / さのの中川 / 瀬たえして / なかれかはるは / 涙なりけり",
        "field_text_romaji": "suminareshi / Sano no nakagawa / sedaeshite / nagare kawaru wa / namida narikeri",
        "field_text_romaji_long": "suminareshi / Sano no nakagawa / sedaeshite / nagare kawaru wa / namida narikeri",
        "field_translations": "[]",
