        "field_id": "6410d51f9192d80cc06771a9",
        "field_kotobagaki": "百首歌たてまつりしとき",
        "field_kotobagaki_long": "百首歌たてまつりしとき",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007100/viewer/99",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "さののわたり",
        "field_text": "駒とめて / 袖うちはらふ / かけもなし / さののわたりの / 雪の夕くれ",
        "field_text_romaji": "koma tomete / sode uchiharau / kage mo nashi / Sano no watari no / yuki no yūgure",
        "field_text_romaji_long": "koma tomete / sode uchiharau / kage mo nashi / Sano no watari no / yuki no yūgure",
        "field_translations": "[{'text': 'When presenting a hundred-poem sequence//  no shelter even/ to brush off my white-coated/ sleeves \\thalting my horse/ near the deserted Sano/ ford on a snowy evening', 'source': 'Rodd, Laurel Rasplica (2015): p.276'}]",
        "field_volume": "巻第六・冬歌"
      },
