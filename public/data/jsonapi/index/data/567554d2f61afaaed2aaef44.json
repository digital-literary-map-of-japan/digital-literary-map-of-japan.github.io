        "field_id": "5c51d01b0eb1485b546a57fc",
        "field_kotobagaki": "五十首たてまつりし時、月前聞雁といふことを",
        "field_kotobagaki_long": "五十首たてまつりし時、月前聞雁といふことを",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007100/viewer/78",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "おおえやま",
        "field_text": "おほえ山 / かたふく月の / 影さえて / 鳥羽田の面に / おつる雁かね",
        "field_text_romaji": "Ōeyama / katabuku tsuki no / kage saete / Tobata no omo ni / otsuru karigane",
        "field_text_romaji_long": "Ōeyama / katabuku tsuki no / kage saete / Tobata no omo ni / otsuru karigane",
        "field_translations": "[{'text': 'Ōe Mountain/ the moon sliding down the sky/ sheds its bright light \\twhile/ on the surface of Toba/ fields the cries of wild geese fall', 'source': 'Rodd, Laurel Rasplica (2015): p.211'}]",
        "field_volume": "巻第五・秋歌下"
      },
