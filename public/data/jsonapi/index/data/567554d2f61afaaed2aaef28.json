        "field_kotobagaki": "平治元年大嘗会主基方辰日参入音声、生野をよめる",
        "field_kotobagaki_long": "平治元年大嘗会主基方辰日参入音声、生野をよめる",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007100/viewer/111",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "おおえやま",
        "field_text": "大江山 / こえていく野の / 末とをみ / 道ある世にも / あひにける哉",
        "field_text_romaji": "Ōeyama / koete Ikuno no / sue tōmi / michi aru yo ni mo / ainikeru kana",
        "field_text_romaji_long": "Ōeyama / koete Ikuno no / sue tōmi / michi aru yo ni mo / ainikeru kana",
        "field_translations": "[{'text': 'crossing Ōe/ Mountain \\ttraveling toward/ the distant end of/ Ikuno road \\tlucky to/ be on the Way in this world', 'source': 'Rodd, Laurel Rasplica (2015): p.310'}]",
        "field_volume": "巻第七・賀歌"
