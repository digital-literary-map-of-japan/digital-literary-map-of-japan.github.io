        "field_document_numbering": "後撰（1024）",
        "field_id": "5c51d01b0eb1485b546a57bd",
        "field_kotobagaki": "菅原のおほいまうちきみの家に侍ける女にかよひ侍けるおとこ、中たえて又とひて侍りけれは",
        "field_kotobagaki_long": "菅原のおほいまうちきみの家に侍ける女にかよひ侍けるおとこ、中たえて又とひて侍りけれは",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007094/viewer/148",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "ふしみ",
        "field_text": "すかはらや / ふしみのさとの / あれしより / 通ひし人の / あともたえにき",
        "field_text_romaji": "Sugawara ya / Fushimi no sato no / areshi yori / kayoishi hito no / ato mo taeniki",
        "field_text_romaji_long": "Sugawara ya / Fushimi no sato no / areshi yori / kayoishi hito no / ato mo taeniki",
        "field_translations": "[{'text': 'Sedge fields lie/ Around the estate of Fushimi,/ All long overgrown;/ He who passed across them/ Has left no tracks at all…', 'source': 'McAuley, Thomas'}]",
        "field_volume": "巻第十四・恋六"
      },
