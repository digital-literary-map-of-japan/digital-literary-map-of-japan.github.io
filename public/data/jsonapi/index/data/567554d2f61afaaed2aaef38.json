        "field_document_numbering": "後撰（1242）",
        "field_id": "5c51d01b0eb1485b546a57be",
        "field_kotobagaki": "ふしみといふ所にて、そのこころをこれかれよみけるに",
        "field_kotobagaki_long": "ふしみといふ所にて、そのこころをこれかれよみけるに",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007094/viewer/187",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "ふしみ",
        "field_text": "すかはらや / ふしみの暮に / みわたせは / 霞にまかふ / をはつせの山",
        "field_text_romaji": "Sugawara ya / Fushimi no kure ni / miwataseba / kasumi ni magau / Ohatsuse no yama",
        "field_text_romaji_long": "Sugawara ya / Fushimi no kure ni / miwataseba / kasumi ni magau / Ohatsuse no yama",
        "field_translations": "[{'text': 'When from the sedge fields/ Of Fushimi at evening time/ I gaze across,/ A mere haze does seem/ The mount of Hatsuse!', 'source': 'McAuley, Thomas'}]",
        "field_volume": "第十七・雑三"
      },
