        "field_place_form": "やつはし",
        "field_text": "もろともに / ゆかぬみかはの / やつはしは / 恋しとのみや / おもひわたらん",
        "field_text_romaji": "morotomo ni / yukanu Mikawa no / Yatsuhashi wa / koishi to nomi ya / omoi wataran",
        "field_text_romaji_long": "morotomo ni / yukanu Mikawa no / Yatsuhashi wa / koishi to nomi ya / omoi wataran",
