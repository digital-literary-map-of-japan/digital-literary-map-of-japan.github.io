        "field_kotobagaki": "あつまのかたにまかりけるに、八はしにてよめる",
        "field_kotobagaki_long": "あつまのかたにまかりけるに、八はしにてよめる",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007099/viewer/189",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "やつはし",
        "field_text": "八はしの / 渡にけふも / とまるかな / こゝに住へき / 身かはと思へと",
        "field_text_romaji": "Yatsuhashi no / watari ni kyō mo / tomaru kana / koko ni sumubeki / mi ka wa to omoedo",
        "field_text_romaji_long": "Yatsuhashi no / watari ni kyō mo / tomaru kana / koko ni sumubeki / mi ka wa to omoedo",
        "field_translations": "[]",
