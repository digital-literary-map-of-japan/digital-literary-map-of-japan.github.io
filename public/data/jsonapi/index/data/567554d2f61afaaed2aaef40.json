        "field_place_form": "やつはし",
        "field_text": "打わたし / なかき心は / やつはしの / くもてにおもふ / 事はたえせし",
        "field_text_romaji": "uchiwatashi  / nagaki kokoro wa / Yatsuhashi no / kumode ni omou / koto wa taeseji",
        "field_text_romaji_long": "uchiwatashi  / nagaki kokoro wa / Yatsuhashi no / kumode ni omou / koto wa taeseji",
        "field_translations": "[{'text': 'Forever/   my long heart/  (like) the Yatsuhashi/  spider-leg, what I think/ will never end.', 'source': 'Kern, J. Christopher'}]",
        "field_volume": "巻第九・恋一　"
