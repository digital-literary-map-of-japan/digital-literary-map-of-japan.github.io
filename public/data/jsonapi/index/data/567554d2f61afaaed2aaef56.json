        "field_chapter": "巻第四・三井寺炎上",
        "field_id": "64aee0d29192d80cc0677253",
        "field_link": [
          {
            "uri": "http://codh.rois.ac.jp/iiif/iiif-curation-viewer/index.html?pages=200003072&pos=280&lang=ja",
            "title": null,
            "options": []
