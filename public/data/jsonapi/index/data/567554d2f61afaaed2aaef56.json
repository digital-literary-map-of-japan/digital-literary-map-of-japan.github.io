        "field_place_form": "おほつ",
        "field_text": "ささ浪や / あふみの宮は / なのみして / 霞たなひき / 宮木もりなし",
        "field_text_romaji": "sazanami ya / Ōmi no miya wa / na nomi shite / kasumi tanabiki / miyagimori nashi",
