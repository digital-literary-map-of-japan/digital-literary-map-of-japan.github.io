        "field_author": "和泉式部",
        "field_author_romaji": "Izumishikibu",
        "field_document_numbering": "金葉（556）",
        "field_id": "6150528eb518fb8bf3eac411",
        "field_kotobagaki": "和泉式部石山にまいりけるに、大津にとまりて夜ふけてききけれは、人のけはひあまたしてののしりける尋けれは、あやしのしつのめよねしらけ侍るなりと申けるをききてよめる",
        "field_kotobagaki_long": "和泉式部石山にまいりけるに、大津にとまりて夜ふけてききけれは、人のけはひあまたしてののしりける尋けれは、あやしのしつのめよねしらけ侍るなりと申けるをききてよめる",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007097/viewer/92",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "おほつ",
        "field_text": "さきのゐる / 松原いかに / さはく覧 / しらけはうたて / 里とよみけり",
        "field_text_romaji": "sagi no iru / matsubara ikani / sawaguran / shirage wa utate / sato to yomi keri",
        "field_text_romaji_long": "sagi no iru / matsubara ikani / sawaguran / shirage wa utate / sato to yomi keri",
        "field_translations": "[{'text': 'Egrets dwell/ Among the pine groves; how/ Noisy they seem;/ Their white plumes unpleasantly/ Echo through the house, it seems.', 'source': 'McAuley, Thomas'}]",
        "field_volume": "巻第九・雑部上"
      },
