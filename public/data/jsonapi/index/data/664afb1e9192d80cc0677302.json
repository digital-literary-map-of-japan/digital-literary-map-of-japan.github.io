        "field_place_form": "はこね",
        "field_text": "箱根路を / 我こえくれは / いつの海や / 沖の小島に / 浪のよるみゆ",
        "field_text_romaji": null,
        "field_text_romaji_long": "Hakoneji o / waga koekureba / Izu no umi ya / oki no kojima ni / nami no yorumiyu",
