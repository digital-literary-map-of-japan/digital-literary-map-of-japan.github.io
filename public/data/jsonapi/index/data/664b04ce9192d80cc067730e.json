        "field_document_numbering": "千載（1278）",
        "field_id": "850a3031-7374-415b-984f-2cf2cb28fc87",
        "field_kotobagaki": "高野の山を住うかれて後、伊勢の国二見の浦の山寺に侍けるに、大神宮の御山をは神路山と申、大日如来の御すいしやくを思ひてよみ侍ける",
        "field_kotobagaki_long": "高野の山を住うかれて後、伊勢の国二見の浦の山寺に侍けるに、大神宮の御山をは神路山と申、大日如来の御すいしやくを思ひてよみ侍ける",
        "field_link": [],
        "field_place_form": "ふたみのうら",
        "field_text": "深く入て / 神路の奥を / 尋ぬれは / 又うへもなき / 嶺の松風",
        "field_text_romaji": null,
        "field_text_romaji_long": null,
        "field_translations": null,
        "field_volume": "巻第二十・神祇歌"
