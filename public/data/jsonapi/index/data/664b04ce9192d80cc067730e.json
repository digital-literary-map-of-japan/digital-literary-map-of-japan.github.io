        "field_author": "ふじわらのかねすけ",
        "field_author_romaji": "Fujiwara no Kanesuke",
        "field_document_numbering": "古今（417）",
        "field_id": "74812a3e-74d7-403d-83d7-fd6546eee367",
        "field_kotobagaki": "たちまのくにのゆへまかりける時に、ふたみの浦といふ所にとまりて、夕さりのかれいひたうへけるに、ともにありける人人、歌よみけるついてに、よめる",
        "field_kotobagaki_long": "たちまのくにのゆへまかりける時に、ふたみの浦といふ所にとまりて、夕さりのかれいひたうへけるに、ともにありける人人、歌よみけるついてに、よめる",
        "field_link": [],
        "field_place_form": "ふたみのうら",
        "field_text": "夕つく夜 / おほつかなきを / 玉くしけ / 二見の浦は / あけてこそ見め",
        "field_text_romaji": null,
        "field_text_romaji_long": null,
        "field_translations": null,
        "field_volume": "巻第九・羇旅歌"
