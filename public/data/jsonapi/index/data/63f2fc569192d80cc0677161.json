            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007093/viewer/77",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "かひ",
        "field_text": "よをさむみ / 置はつ霜を / はらひつつ / 草の枕に / あまたたひねぬ",
        "field_text_romaji": "yo o samumi / oku hatsushimo o / harai tsutsu / kusa no makura ni / amata tabinenu",
        "field_text_romaji_long": "yo o samumi / oku hatsushimo o / harai tsutsu / kusa no makura ni / amata tabinenu",
        "field_translations": null,
        "field_volume": "巻第九・羇旅歌"
