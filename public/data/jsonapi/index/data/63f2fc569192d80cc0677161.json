        "field_place_form": "かひ",
        "field_text": "都人 / いかにととはは / 山たかみ / はれぬ雲井に / わふとこたへよ",
        "field_text_romaji": "miyakobito / ikani to towaba / yama takami / harenu kumoi ni / wabu to kotae yo",
        "field_text_romaji_long": "miyakobito / ikani to towaba / yama takami / harenu kumoi ni / wabu to kotae yo",
