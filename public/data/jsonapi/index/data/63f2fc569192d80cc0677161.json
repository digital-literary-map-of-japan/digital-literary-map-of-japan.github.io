        "field_document_numbering": "金葉（567）",
        "field_id": "6410d2429192d80cc06771a1",
        "field_kotobagaki": "甲斐国よりのほりて、おはする人のもとにありけるか、はかなき事にてそのおはか、なありそ、とてをひいたしたりけれはよめる",
        "field_kotobagaki_long": "甲斐国よりのほりて、おはする人のもとにありけるか、はかなき事にてそのおはか、なありそ、とてをひいたしたりけれはよめる",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007097/viewer/95",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "かひ",
        "field_text": "鳥の子の / またかひなから / あらませは / おはといふ物は / おひいてさらまし",
        "field_text_romaji": "tori no ko no / mada kai nagara / aramaseba / oba toiu mono wa / oiidezaramashi",
        "field_text_romaji_long": "tori no ko no / mada kai nagara / aramaseba / oba toiu mono wa / oiidezaramashi",
        "field_translations": "[]",
        "field_volume": "巻第九・雑部上"
