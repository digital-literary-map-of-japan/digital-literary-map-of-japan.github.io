        "field_place_form": "かひ",
        "field_text": "かひかねを / さやにもみしか / けけれなく / よこほりふせる / さやの中山",
        "field_text_romaji": "Kai ga ne o / sayani mo mishika / kekere naku / yoko horifuseru / Saya no nakayama",
        "field_text_romaji_long": "Kai ga ne o / sayani mo mishika / kekere naku / yoko horifuseru / Saya no nakayama",
        "field_translations": "[{'text': 'A Kai song.//  how I wish I could/ clearly see the mountains of/ Kai \\theartlessly/  it stretches before my eyes/ Sayanonaka Mountain', 'source': 'Rodd, Laurel R. and Henkenius, Mary C. (1984): p.373'}]",
        "field_volume": "巻第二十・東歌"
