        "field_kotobagaki": "かひのくにに、あひしりて侍ける人とふらはんとてまかりけるみちなかにて、にはかにやまひをして、いまいまと成にけれは、よみて、京にもてまかりて、母に見せよといひて、人につけ侍けるうた",
        "field_kotobagaki_long": "かひのくにに、あひしりて侍ける人とふらはんとてまかりけるみちなかにて、にはかにやまひをして、いまいまと成にけれは、よみて、京にもてまかりて、母に見せよといひて、人につけ侍けるうた",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007093/viewer/125",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "かひ",
        "field_text": "かりそめの / ゆきかひちとそ / 思ひこし / 今はかきりの / かとて成けり",
        "field_text_romaji": "karisome no / yukikaiji to zo / omoikoshi / ima wa kagiri no / kadode narikeri",
        "field_text_romaji_long": "karisome no / yukikaiji to zo / omoikoshi / ima wa kagiri no / kadode narikeri",
        "field_translations": null,
        "field_volume": "巻第十六・哀傷歌"
