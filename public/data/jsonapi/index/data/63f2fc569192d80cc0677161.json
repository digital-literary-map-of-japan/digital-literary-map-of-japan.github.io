        "field_place_form": "かひ",
        "field_text": "いつ方と / かひの白根は / しらねとも / 雪ふることに / 思ひこそやれ",
        "field_text_romaji": "izukata to / Kai no shirane wa / shirane domo / yuki furu gotoni / omoi koso yare",
        "field_text_romaji_long": "izukata to / Kai no shirane wa / shirane domo / yuki furu gotoni / omoi koso yare",
