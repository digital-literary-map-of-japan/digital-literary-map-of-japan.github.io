        "field_author_romaji": "Fujiwara no Akinaka",
        "field_document_numbering": "新古今（972）",
        "field_id": "6150528fb518fb8bf3eac43c",
        "field_kotobagaki": "堀河院御時百首歌奉りけるとき、旅歌",
        "field_kotobagaki_long": "堀河院御時百首歌奉りけるとき、旅歌",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007100/viewer/146",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "きさかた",
        "field_text": "さすらふる / 我身にしあれは / きさ方や / 蜑のとまやに / あまたたひねぬ",
        "field_text_romaji": "sasurauru / wa ga mi ni shi areba / Kisakata ya / ama no tomaya ni / amata tabinenu",
        "field_text_romaji_long": "sasurauru / wa ga mi ni shi areba / Kisakata ya / ama no tomaya ni / amata tabinenu",
        "field_translations": "[{'text': 'a wanderer am/ I \\tone who drifts through the world  ̶  / at Kisa Lagoon/ in the fisherfolk’s rough reed/ huts \\thow often have I slept', 'source': 'Rodd, Laurel Rasplica (2015): p.399'}]",
        "field_volume": "巻第十・羇旅歌"
      },
