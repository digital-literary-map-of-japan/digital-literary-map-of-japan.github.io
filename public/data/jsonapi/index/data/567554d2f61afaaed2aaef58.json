        "field_id": "6150528fb518fb8bf3eac43b",
        "field_kotobagaki": "出羽のくににまかりて、きさかたといふところにてよめる",
        "field_kotobagaki_long": "出羽のくににまかりて、きさかたといふところにてよめる",
        "field_link": [
          {
            "uri": "https://kotenseki.nijl.ac.jp/biblio/200007096/viewer/98",
            "title": null,
            "options": []
          }
        ],
        "field_place_form": "きさかた",
        "field_text": "よの中は / かくてもへけり / きさかたの / あまのとまやを / 我宿にして",
        "field_text_romaji": "yo no naka wa / kakutemo hekeri / Kisakata no / ama no tomaya o / wa ga yado ni shite",
        "field_text_romaji_long": "yo no naka wa / kakutemo hekeri / Kisakata no / ama no tomaya o / wa ga yado ni shite",
        "field_translations": "[{'text': 'This world/ Has come to such a pass;/ In Kisakata,/ Fisherfolks’ straw-matted huts/ Have become my lodging!', 'source': 'McAuley, Thomas'}]",
        "field_volume": "巻第九・羇旅"
      },
